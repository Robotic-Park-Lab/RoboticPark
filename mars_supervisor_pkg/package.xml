<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mars_supervisor_pkg</name>
  <version>0.0.0</version>
  <description>Supervisor node that orchestrates RoboticPark multi-robot experiments from a YAML config: spawning/monitoring agents and running herding/affine-formation control.</description>
  <maintainer email="fjmanas@dia.uned.es">Francisco Jose Manas</maintainer>
  <license>BSD-3-Clause</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf_transformations</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
